{
  "openapi": "3.0.0",
  "info": {
    "title": "Payment & User Service",
    "version": "2.0.0"
  },
  "paths": {
    "/api/v1/users": {
      "get": {
        "summary": "Get user profile",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User profile data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user_id": { "type": "string" },
                    "email": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
